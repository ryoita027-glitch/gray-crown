{
  "name": "gray-crown-v23-frontier-second-slice",
  "private": true,
  "version": "23.0.0",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "verify-authority": "python tools/verify_project_authority.py",
    "verify-hygiene": "python tools/verify_repo_hygiene.py",
    "verify-python-syntax": "python -m compileall -q tools tests",
    "verify-triton-completion": "python tools/verify_triton_completion_state.py",
    "build-triton-completion-evidence": "python tools/build_karen_triton_completion_evidence.py",
    "check": "npm run verify-hygiene && npm run verify-authority && npm run verify-python-syntax && node tests/check-syntax.js && npm test && npm run browser-test",
    "browser-test": "python tests/browser_v21_gate.py && python tests/browser_alpha2_frontier_e2e_test.py && python tests/browser_alpha2_frontier_second_e2e_test.py",
    "frontier-e2e": "python tests/browser_alpha2_frontier_e2e_test.py",
    "frontier2-e2e": "python tests/browser_alpha2_frontier_second_e2e_test.py",
    "generate-karen-assets": "python tools/generate_karen_prototype_assets.py --out assets/characters/karen",
    "verify-karen-assets": "python tools/verify_karen_prototype_assets.py",
    "generate-triton-assets": "python tools/generate_triton_prototype_assets.py --out assets/characters/triton",
    "verify-triton-assets": "python tools/verify_triton_prototype_assets.py",
    "prototype-browser-test": "python tools/run_browser_suite.py",
    "prototype-check": "npm run verify-hygiene && npm run verify-authority && npm run verify-python-syntax && npm run verify-karen-assets && npm run generate-triton-assets && npm run verify-triton-assets && npm run verify-triton-completion && node tests/check-syntax.js && npm test && npm run prototype-browser-test",
    "environment-generate": "python tools/environment/generate_environment_prototype_v1.py",
    "environment-verify": "python tools/environment/verify_environment_prototype_v1.py",
    "environment-scope": "python tools/environment/verify_environment_scope_v1.py",
    "environment-evidence": "python tools/environment/build_environment_character_evidence_v1.py",
    "environment-browser-test": "python tests/environment/browser_environment_prototype_e2e_test.py",
    "environment-check": "npm run environment-scope && npm run environment-generate && npm run environment-verify && node --test tests/environment/environment_prototype.test.js && npm run environment-evidence && npm run environment-browser-test"
  }
}
